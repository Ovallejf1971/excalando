    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Construye SQL UPSERT en conversaciones por whatsapp_number\nconst i = $input.item.json;\n\nfunction esc(s) {\n  if (s === null || s === undefined) return 'NULL';\n  return \"'\" + String(s).replace(/'/g, \"''\") + \"'\";\n}\n\nconst sql = `INSERT INTO conversaciones (whatsapp_number, customer_name, status, first_message_at, last_message_at)\nVALUES (${esc(i.contact_phone)}, ${esc(i.contact_name)}, 'active', NOW(), NOW())\nON CONFLICT (whatsapp_number) DO UPDATE SET\n  customer_name = COALESCE(EXCLUDED.customer_name, conversaciones.customer_name),\n  last_message_at = NOW(),\n  status = CASE WHEN conversaciones.status = 'resolved' THEN 'active' ELSE conversaciones.status END\nRETURNING id;`;\n\nreturn { json: { sql, ...i } };"
      },
      "id": "8b57dd6e-6f9c-4a70-8ac1-e6d537eb4471",
