    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Toma el conversacion_id devuelto y enriquece el contexto\nconst pgResult = $input.item.json;\nconst original = $('Filtrar y normalizar evento').item.json;\nconst conversacionId = pgResult.id;\n\nif (!conversacionId) {\n  throw new Error('Postgres UPSERT no devolvio conversacion_id');\n}\n\nreturn {\n  json: {\n    ...original,\n    conversacion_id: conversacionId\n  }\n};"
      },
