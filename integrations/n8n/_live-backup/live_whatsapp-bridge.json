        "specifyBody": "json",
        "jsonBody": "={\n  \"message\": {{ JSON.stringify($('Extraer conversacion_id').item.json.message) }},\n  \"contact_name\": {{ JSON.stringify($('Extraer conversacion_id').item.json.contact_name) }},\n  \"contact_phone\": {{ JSON.stringify($('Extraer conversacion_id').item.json.contact_phone) }},\n  \"conversacion_id\": {{ $('Extraer conversacion_id').item.json.conversacion_id }}\n}",
