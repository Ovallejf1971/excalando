    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Filtra y normaliza el evento de Evolution\nconst body = $input.item.json.body || $input.item.json;\nconst event = body.event;\nconst data = body.data;\n\nif (event !== 'messages.upsert') {\n  return { json: { skip: true, reason: `Evento ignorado: ${event}` } };\n}\n\nif (!data) {\n  return { json: { skip: true, reason: 'Sin data' } };\n}\n\nif (data.key?.fromMe === true) {\n  return { json: { skip: true, reason: 'Mensaje propio (fromMe)' } };\n}\n\nconst msg = data.message || {};\nconst messageText = msg.conversation\n  || msg.extendedTextMessage?.text\n  || msg.imageMessage?.caption\n  || msg.videoMessage?.caption\n  || '';\n\nif (!messageText.trim()) {\n  return { json: { skip: true, reason: 'Mensaje no es texto' } };\n}\n\nconst remoteJid = data.key?.remoteJid || '';\nconst phone = remoteJid.replace('@s.whatsapp.net', '').replace('@c.us', '');\nconst pushName = data.pushName || null;\n\nif (remoteJid.includes('@g.us')) {\n  return { json: { skip: true, reason: 'Mensaje de grupo (ignorados en Fase 2)' } };\n}\n\nreturn {\n  json: {\n    skip: false,\n    message: messageText,\n    contact_phone: phone,\n    contact_name: pushName,\n    remoteJid,\n    instance: body.instance || 'excalando',\n    messageId: data.key?.id\n  }\n};"
      },
      "id": "a12d0122-db11-4d83-8f47-e0f429faaef7",
      "name": "Filtrar y normalizar evento",
      "type": "n8n-nodes-base.code",
