      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// Toma respuesta del Conversational + prepara payloads para SQLs y para Twilio\nconst convResp = $input.item.json;\nconst original = $('Extraer conversacion_id').item.json;\nconst meta = convResp.metadata || {};\nconst convId = original.conversacion_id;\n\nfunction esc(s) {\n  if (s === null || s === undefined) return 'NULL';\n  return \"'\" + String(s).replace(/'/g, \"''\") + \"'\";\n}\n\nconst sqlUpdateConv = `UPDATE conversaciones SET ai_handled_count = ai_handled_count + 1, last_message_at = NOW() WHERE id = ${convId}; INSERT INTO mensajes_analisis (conversacion_id, message_id, direction, text, created_at) VALUES (${convId}, ${esc('out-'+convId+'-'+Date.now())}, 'out', ${esc(convResp.respuesta || '')}, NOW());`;\n\nlet sqlInsertAlerta = null;\nif (meta.tool_called === 'escalar_a_humano' || meta.needs_human_review === true) {\n  const motivo = meta.tool_args?.motivo || 'Escalacion automatica detectada';\n  const urgencia = meta.tool_args?.urgencia || 'media';\n  const severity = (urgencia === 'alta') ? 'alta' : 'media';\n  sqlInsertAlerta = `INSERT INTO alertas (conversacion_id, tipo, severity, message, notified_via, reviewed) VALUES (${convId}, ${esc('escalation_request')}, ${esc(severity)}, ${esc(motivo)}, ARRAY['log']::text[], false);`;\n}\n\nreturn {\n  json: {\n    // Para Twilio (whatsapp: prefix)\n    twilio_to: 'whatsapp:+' + original.contact_phone,\n    twilio_from: original.to, // El \"To\" del mensaje entrante es nuestro sender Twilio\n    twilio_body: convResp.respuesta || '(no respuesta)',\n    // Para Postgres\n    sql_update_conv: sqlUpdateConv,\n    sql_insert_alerta: sqlInsertAlerta,\n    needs_alerta: !!sqlInsertAlerta,\n    metadata: meta,\n    contact_name: original.contact_name\n  }\n};"
        },
