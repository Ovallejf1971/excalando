      "parameters": {
        "operation": "executeQuery",
        "query": "{{ $json.sql }}",
        "options": {}
      },
      "id": "43d9a44a-9999-40b1-9737-6799cb65cdfe",
      "name": "Postgres: UPSERT conv",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        -1920,
        80
      ],
      "credentials": {
        "postgres": {
          "id": "qa2xCOKMjuiMpSsd",
          "name": "Postgres eXcalando"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const pgResult = $input.item.json;\nconst original = $('Filtrar y normalizar Twilio').item.json;\nconst conversacionId = pgResult.id;\n\nif (!conversacionId) {\n  throw new Error('Postgres UPSERT no devolvio conversacion_id');\n}\n\nreturn {\n  json: {\n    ...original,\n    conversacion_id: conversacionId\n  }\n};"
      },
      "id": "49595bdb-e4a1-49c1-9bcb-ca6d2ea9e186",
      "name": "Extraer conversacion_id",
      "type": "n8n-nodes-base.code",
