        -1680,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// INSERT mensaje entrante\nconst i = $input.item.json;\n\nfunction esc(s) {\n  if (s === null || s === undefined) return 'NULL';\n  return \"'\" + String(s).replace(/'/g, \"''\") + \"'\";\n}\n\nconst sql = `INSERT INTO mensajes_analisis (conversacion_id, message_id, direction, text, sentiment, emotion, intent, topics, flags, opportunity_score, risk_score, summary_es, created_at)\nVALUES (${i.conversacion_id}, ${esc(i.messageId)}, ${esc('in')}, ${esc(i.message)}, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NOW());`;\n\nreturn { json: { sql, ...i } };"
      },
