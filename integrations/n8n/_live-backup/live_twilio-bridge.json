        "notes": "Endpoint que Twilio llama cuando entra un mensaje WhatsApp. Twilio manda form-urlencoded (n8n lo parsea a body.X). Campos clave: Body, From, To, ProfileName, WaId, MessageSid."
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "// Twilio manda form-urlencoded, n8n lo parsea como body o directamente en $json\n// Campos clave del webhook de Twilio WhatsApp:\n// - Body: texto del mensaje\n// - From: 'whatsapp:+57XXXXXXXXX' (sender)\n// - To: 'whatsapp:+16164056029' (nuestro Twilio sender)\n// - ProfileName: nombre del contacto\n// - WaId: phone sin '+' (ej. '57321XXXXXX')\n// - MessageSid: ID unico del mensaje\n// - NumMedia: '0' si es solo texto, '>0' si trae adjuntos\n\nconst body = $input.item.json.body || $input.item.json;\n\nconst messageText = (body.Body || '').trim();\nconst from = body.From || '';\nconst to = body.To || '';\nconst pushName = body.ProfileName || null;\nconst waId = body.WaId || '';\nconst messageId = body.MessageSid || body.SmsMessageSid || '';\nconst numMedia = parseInt(body.NumMedia || '0', 10);\n\nif (!messageText && numMedia === 0) {\n  return { json: { skip: true, reason: 'Mensaje vacio o no es texto' } };\n}\n\nif (numMedia > 0 && !messageText) {\n  return { json: { skip: true, reason: 'Mensaje multimedia sin caption (ignorado en Fase 2)' } };\n}\n\nif (!from.startsWith('whatsapp:')) {\n  return { json: { skip: true, reason: `From inesperado: ${from}` } };\n}\n\n// Extraer telefono limpio (sin 'whatsapp:+')\nconst phone = from.replace('whatsapp:+', '').replace('whatsapp:', '');\n\nreturn {\n  json: {\n    skip: false,\n    message: messageText,\n    contact_phone: phone,\n    contact_name: pushName,\n    from,\n    to,\n    waId,\n    messageId\n  }\n};"
        },
        "id": "a613130c-1de8-4d67-a201-5747d04725d3",
        "name": "Filtrar y normalizar Twilio",
        "type": "n8n-nodes-base.code",
