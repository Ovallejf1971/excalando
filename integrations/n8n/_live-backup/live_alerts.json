    {
      "parameters": {
        "jsCode": "// Computa severidad y formatea mensaje para Telegram\nconst body = $input.item.json.body || $input.item.json;\nconst analysis = body.analysis || {};\nconst flags = analysis.flags || [];\nconst sentiment = analysis.sentiment ?? 0;\nconst opportunity = analysis.opportunity_score ?? 0;\nconst risk = analysis.risk_score ?? 0;\nconst text = body.text || '(sin texto)';\nconst summary = analysis.summary_es || '(sin resumen)';\nconst conversacion_id = body.conversacion_id || null;\nconst customer = body.customer_name || 'Anónimo';\n\nlet severity = 'baja';\nlet emoji = '🟢';\nlet title = 'EVENTO BAJO';\nlet tipo = 'low_priority';\n\nif (flags.includes('legal_mention')) {\n  severity = 'critica';\n  emoji = '🚨';\n  title = 'ALERTA CRÍTICA · MENCIÓN LEGAL';\n  tipo = 'legal_mention';\n} else if (flags.includes('bad_language')) {\n  severity = 'critica';\n  emoji = '🚨';\n  title = 'ALERTA CRÍTICA · LENGUAJE AGRESIVO';\n  tipo = 'bad_language';\n} else if (sentiment < -0.5) {\n  severity = 'alta';\n  emoji = '🟠';\n  title = 'ALERTA ALTA · SENTIMENT NEGATIVO';\n  tipo = 'sentiment_drop';\n} else if (flags.includes('escalation_request')) {\n  severity = 'media';\n  emoji = '🟡';\n  title = 'CLIENTE PIDE HUMANO';\n  tipo = 'escalation_request';\n} else if (opportunity > 0.8) {\n  severity = 'media';\n  emoji = '💎';\n  title = 'OPORTUNIDAD CALIENTE';\n  tipo = 'high_value_opportunity';\n}\n\n// Formatear mensaje Telegram (Markdown)\nconst message = `${emoji} *${title}*\\n\\n` +\n  `*Cliente:* ${customer}\\n` +\n  `*Sentiment:* ${sentiment} | *Risk:* ${risk} | *Opp:* ${opportunity}\\n` +\n  (flags.length > 0 ? `*Flags:* ${flags.join(', ')}\\n` : '') +\n  `\\n📝 *Mensaje del cliente:*\\n_${text.substring(0, 300)}${text.length > 300 ? '...' : ''}_\\n\\n` +\n  `🔍 *Análisis IA:*\\n${summary}\\n\\n` +\n  `🔗 *Conversación ID:* ${conversacion_id ?? 'sin asignar'}`;\n\nreturn {\n  severity,\n  tipo,\n  emoji,\n  title,\n  message,\n  conversacion_id,\n  customer,\n  shouldNotifyTelegram: severity !== 'baja'\n};"
      },
