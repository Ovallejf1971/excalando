# Token del usuario DEDICADO "eXcalando Espejo" (espejo@excalando.co, admin en cuenta 3),
# creado por Rails para no depender del login personal de un socio. Se llama a Chatwoot por
# red interna (chatwoot_web:3000) porque el proxy OLS remueve el header api_access_token.
CW_TOKEN=
CW_URL=http://chatwoot_web:3000
CW_ACCOUNT_ID=3
CW_INBOX_ID=2

# Postgres (agencia_digital) — fuente de los mensajes del asistente
PG_HOST=shared_postgres
PG_PW=

POLL_SECONDS=30
