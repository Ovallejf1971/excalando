# --- OBLIGATORIO ---
# Genera una clave larga y aleatoria:  python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=

# --- Envío del código por correo (mismo webhook de Gmail que usa el PMO en n8n) ---
GMAIL_WEBHOOK_URL=

# --- Administradores semilla (correos separados por coma, se crean pre-aprobados) ---
ADMIN_EMAILS=ovallejf@gmail.com

# --- Sitio estático a proteger (build de Astro Starlight) ---
SITE_DIST=../interno/dist

# --- Sesión ---
# En producción (HTTPS) ponlo en true. En dev local (HTTP) déjalo en false.
WEB_COOKIE_SECURE=false
SESSION_HORAS=12

# --- Base de datos de usuarios (SQLite) ---
DB_PATH=./data/interno.db
